# ==============================================================================
# AirfareX India — Production & Deployment Configuration (.env.example)
# DO NOT commit production .env with real secret keys to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Application Security & Token Secret
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFAREX_SECRET_KEY=replace_with_a_secure_64_character_hex_key
SANDBOX_SECRET=airfarex_secure_sandbox_hmac_secret_2026

# ==============================================================================
# Production CORS & Trusted Domains
# Comma-separated list of allowed frontend origins (e.g. https://airfarex.in,https://app.airfarex.in)
# ==============================================================================
CORS_ORIGINS=https://airfarex.example.com,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=https://airfarex.example.com

# ==============================================================================
# Flight Search & GDS Provider Configuration (Amadeus Self-Service API)
# Get credentials from: https://developers.amadeus.com/
# Leave empty to run with MockDevelopmentProvider in development/sandbox mode.
# ==============================================================================
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_keep_confidential
AMADEUS_HOSTNAME=test

# ==============================================================================
# Payment Gateway Configuration (Razorpay India)
# Get keys from: https://dashboard.razorpay.com/#/accesskeys
# Leave empty to run in cryptographic sandbox simulation mode.
# ==============================================================================
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_keep_confidential
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_for_events

# ==============================================================================
# Supabase Cloud Database Configuration (PostgREST / Postgres)
# Get credentials from: https://app.supabase.com/project/_/settings/api
# IMPORTANT: NEVER place SUPABASE_SERVICE_ROLE_KEY in frontend JavaScript code!
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_KEY=your_supabase_anon_or_service_role_key


