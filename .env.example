# ==============================================================================
# AirfareX India — Environment Configuration Template (.env.example)
# DO NOT commit production .env with secret keys to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false

# Application Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFAREX_SECRET_KEY=replace_with_a_secure_64_character_hex_key
SANDBOX_SECRET=airfarex_secure_sandbox_hmac_secret_2026

# ==============================================================================
# Payment Gateway Configuration (Razorpay India)
# Get keys from: https://dashboard.razorpay.com/#/accesskeys
# If left empty, AirfareX automatically runs in Cryptographic Sandbox Mode
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_keep_confidential

# ==============================================================================
# Supabase Cloud Database Configuration (PostgREST / Postgres)
# Get credentials from: https://app.supabase.com/project/_/settings/api
# IMPORTANT: NEVER expose SUPABASE_KEY to frontend JavaScript code!
# ==============================================================================
SUPABASE_URL=https://thtwkhhccxmkkgwtoleb.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# Webhook Secrets
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_for_events
